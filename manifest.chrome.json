{
  "manifest_version": 3,
  "name": "Browser Context Copier",
  "version": "1.1.0",
  "description": "Copy the readable content of the current page to your clipboard as clean Markdown, ready to paste into an LLM.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy Page Context",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_page": "options/index.html",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "contextMenus", "storage"],
  "commands": {
    "copy-page-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current page's readable content to the clipboard"
    }
  }
}
