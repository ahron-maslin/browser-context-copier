{
  "manifest_version": 3,
  "name": "Browser Context Copier",
  "version": "0.1.0",
  "description": "Copy the readable content of the current page to your clipboard as clean Markdown, ready to paste into an LLM.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy Page Context",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background/background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite", "contextMenus", "storage"],
  "commands": {
    "copy-page-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current page's readable content to the clipboard"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{5e24f074-3d8b-4839-b50c-c96561cc98cc}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
