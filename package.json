{
  "name": "browser-context-copier",
  "version": "1.0.0",
  "private": true,
  "description": "Extract readable page content and copy it to the clipboard as clean Markdown, for pasting into an LLM.",
  "license": "MIT",
  "author": {
    "name": "Ahron Maslin",
    "email": "ahronkaylawedding@gmail.com"
  },
  "homepage": "https://github.com/ahron-maslin/browser-context-copier",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahron-maslin/browser-context-copier.git"
  },
  "bugs": {
    "url": "https://github.com/ahron-maslin/browser-context-copier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "TARGET=chrome node scripts/build.mjs",
    "build:firefox": "TARGET=firefox node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir=dist/firefox",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0"
  }
}
